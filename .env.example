# MySQL-verbinding
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=certif_clock
DB_USER=certif_clock
DB_PASSWORD=changeme

# Maak het eerste owner-account via /install.php op een lege database.

# Sessie
SESSION_NAME=certif_clock_session
SESSION_LIFETIME=28800
SECURE_COOKIES=false

# Eenvoudige rate limiting (aanvragen per IP per tijdvenster in seconden)
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=60
